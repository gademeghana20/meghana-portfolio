# Copy to .env.local and fill in. Never commit .env.local.
# Supabase dashboard -> Project Settings -> API Keys
NEXT_PUBLIC_SUPABASE_URL=
# Publishable (anon) key. Safe for the browser; Row Level Security protects data.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# The secret / service_role key is intentionally NOT used by this project.
# Admin edits run as the logged-in admin user and are enforced by RLS.
